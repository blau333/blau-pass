{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blau",
  "version": "0.1.0",
  "identifier": "com.rustvault.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm.cmd run dev -- --host 127.0.0.1",
      "cwd": ".."
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "npm.cmd run build",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "blau",
        "width": 1213,
        "height": 766,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' asset: data:;"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/blau333/blau-pass/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1Q0IwQ0JGN0VDODYyN0QKUldSOVlzaCt2d3pMcGJidTA1Q2tkaGVwb3hVTHZwSW4xbTRRSFNqd0xKR3UyektYb3RMdnJRSzIK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
